# Public URL where backend serves uploaded/processed videos (Meta needs a public URL)
# For testing: ngrok URL or your machine's LAN IP. For production: real domain.
PUBLIC_BASE_URL=http://localhost:8000

# Instagram Graph API (https://developers.facebook.com/docs/instagram-api)
IG_USER_ID=
IG_ACCESS_TOKEN=
IG_API_VERSION=v20.0

# Tavily — for trending tag research
TAVILY_API_KEY=

# LLM (OpenAI-compatible). Default: Groq free tier (sign up at groq.com)
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant

# Local transcription model: tiny|base|small|medium
WHISPER_MODEL=base
# Force language (en, hi, gu, ...) — empty = auto-detect
WHISPER_LANGUAGE=

# Pollinations free AI image generation (no key). Set false to disable.
POLLINATIONS_ENABLED=true
